<Window x:Class="RemoteMic.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RemoteMic.Windows.ViewModels"
        mc:Ignorable="d"
        Title="RemoteMic"
        Width="1000" Height="690"
        MinWidth="880" MinHeight="660"
        MaxWidth="1600" MaxHeight="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PanelBrush}"
        Icon="pack://application:,,,/Assets/remotemic-icon.png"
        Closing="Window_Closing">
  <Window.Resources>
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="17" />
    </Style>

    <Style x:Key="SegmentButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="17,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Container" Background="{TemplateBinding Background}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Container" Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Container" Property="BorderBrush" Value="{DynamicResource GreenBrush}" />
                <Setter TargetName="Container" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PillButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Container"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="13">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Container" Property="BorderBrush" Value="{DynamicResource GreenBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Container" Property="Opacity" Value="0.7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChannelToggleStyle" TargetType="ToggleButton">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ToggleBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource GreenDeepBrush}" />
                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource GreenBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.82" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LevelStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
      <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border Background="{TemplateBinding Background}" CornerRadius="4" />
              <Border x:Name="PART_Track" CornerRadius="4">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                        Background="{TemplateBinding Foreground}" CornerRadius="4" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MappingComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Margin" Value="3,2" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource PanelBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="88" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Three-part header: brand, page selector, status. -->
    <Border Grid.Row="0" Margin="18,15,18,9" Style="{StaticResource CardStyle}">
      <Grid Margin="17,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="42" Height="42" CornerRadius="10" ClipToBounds="True">
            <Image Source="pack://application:,,,/Assets/remotemic-icon.png" Stretch="UniformToFill" />
          </Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="RemoteMic" FontSize="21" FontWeight="Bold" />
            <TextBlock Text="{DynamicResource AppSubtitle}" Margin="0,2,0,0"
                       Foreground="{DynamicResource SecondaryBrush}" FontSize="11" />
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" Background="{DynamicResource TrackBrush}" CornerRadius="12"
                Padding="3" VerticalAlignment="Center">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="125" />
              <ColumnDefinition Width="125" />
            </Grid.ColumnDefinitions>
            <Button x:Name="AudioTabButton" Grid.Column="0" Click="AudioTab_Click"
                    Style="{StaticResource SegmentButtonStyle}"
                    Background="{DynamicResource SurfaceBrush}"
                    AutomationProperties.Name="{DynamicResource AudioTab}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="☷" Margin="0,0,7,0" FontSize="15" />
                <TextBlock Text="{DynamicResource AudioTab}" />
              </StackPanel>
            </Button>
            <Button x:Name="MappingTabButton" Grid.Column="1" Click="MappingTab_Click"
                    Style="{StaticResource SegmentButtonStyle}"
                    AutomationProperties.Name="{DynamicResource MappingTab}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="⌨" Margin="0,0,7,0" FontSize="15" />
                <TextBlock Text="{DynamicResource MappingTab}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource PillButtonStyle}" Click="Donate_Click"
                  AutomationProperties.Name="{DynamicResource Donate}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="☕" Margin="0,0,6,0" Foreground="{DynamicResource SecondaryBrush}" />
              <TextBlock Text="{DynamicResource Donate}" Foreground="{DynamicResource SecondaryBrush}" />
            </StackPanel>
          </Button>
          <Border Margin="10,0,0,0" Padding="12,8" Background="{DynamicResource AmberDeepBrush}"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource AmberBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ConnectionSummary}" Margin="7,0,0,0"
                         Foreground="{DynamicResource AmberBrush}" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Audio console -->
    <Grid Grid.Row="1" Margin="18,7,18,18"
          Visibility="{Binding IsAudioPage, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="286" />
        <RowDefinition Height="15" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="17">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0" Margin="22,22,22,18">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource LocalMic}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="{DynamicResource LocalMicSubtitle}" Margin="0,3,0,0"
                       Foreground="{DynamicResource SecondaryBrush}" FontSize="11" />
            <StackPanel Grid.Row="2" Margin="0,18,0,0">
              <Grid Margin="0,0,0,9">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="{DynamicResource TertiaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding LocalState}" Margin="7,0,0,0"
                             Foreground="{DynamicResource SecondaryBrush}" FontWeight="SemiBold" FontSize="11" />
                </StackPanel>
                <TextBlock Text="{Binding LocalLevelText}" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryBrush}" />
              </Grid>
              <ProgressBar Style="{StaticResource LevelStyle}" Value="{Binding LocalLevel}" />
              <Grid Margin="0,5,0,0">
                <TextBlock Text="{DynamicResource LevelLow}" Foreground="{DynamicResource TertiaryBrush}" FontSize="9" />
                <TextBlock Text="{DynamicResource LevelHigh}" HorizontalAlignment="Right" Foreground="{DynamicResource TertiaryBrush}" FontSize="9" />
              </Grid>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Top">
              <ToggleButton Content="{DynamicResource Mute}" Width="74" Style="{StaticResource ChannelToggleStyle}"
                            IsChecked="{Binding LocalMuted}" />
              <ToggleButton Content="{DynamicResource Solo}" Width="74" Margin="9,0,0,0"
                            Style="{StaticResource ChannelToggleStyle}" IsChecked="{Binding LocalSolo}" />
            </StackPanel>
            <Grid Grid.Row="4">
              <TextBlock Text="{DynamicResource Participating}" Foreground="{DynamicResource SecondaryBrush}" FontSize="10" />
              <CheckBox Content="{DynamicResource AlwaysOn}" HorizontalAlignment="Right" FontSize="10"
                        IsChecked="{Binding CaptureAlwaysOn}" Foreground="{DynamicResource SecondaryBrush}" />
            </Grid>
          </Grid>

          <Border Grid.Column="1" Background="{DynamicResource LineSoftBrush}" />

          <Grid Grid.Column="2" Margin="22,22,22,18">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource RemoteMic}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="{DynamicResource RemoteMicSubtitle}" Margin="0,3,0,0"
                       Foreground="{DynamicResource SecondaryBrush}" FontSize="11" />
            <StackPanel Grid.Row="2" Margin="0,18,0,0">
              <Grid Margin="0,0,0,9">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="{DynamicResource TertiaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding RemoteState}" Margin="7,0,0,0"
                             Foreground="{DynamicResource SecondaryBrush}" FontWeight="SemiBold" FontSize="11" />
                </StackPanel>
                <TextBlock Text="{Binding RemoteLevelText}" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryBrush}" />
              </Grid>
              <ProgressBar Style="{StaticResource LevelStyle}" Value="{Binding RemoteLevel}" />
              <Grid Margin="0,5,0,0">
                <TextBlock Text="{DynamicResource LevelLow}" Foreground="{DynamicResource TertiaryBrush}" FontSize="9" />
                <TextBlock Text="{DynamicResource LevelHigh}" HorizontalAlignment="Right" Foreground="{DynamicResource TertiaryBrush}" FontSize="9" />
              </Grid>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Top">
              <ToggleButton Content="{DynamicResource Mute}" Width="74" Style="{StaticResource ChannelToggleStyle}"
                            IsChecked="{Binding RemoteMuted}" />
              <ToggleButton Content="{DynamicResource Solo}" Width="74" Margin="9,0,0,0"
                            Style="{StaticResource ChannelToggleStyle}" IsChecked="{Binding RemoteSolo}" />
            </StackPanel>
            <TextBlock Grid.Row="4" Text="{DynamicResource Participating}"
                       Foreground="{DynamicResource SecondaryBrush}" FontSize="10" />
          </Grid>

          <Border Grid.Column="3" Background="{DynamicResource LineSoftBrush}" />

          <Border Grid.Column="4" Background="{DynamicResource AmberDeepBrush}" CornerRadius="0,16,16,0">
            <Grid Margin="22,22,22,18">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="{DynamicResource MixedOutput}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Grid.Row="1" Text="{DynamicResource SentToApps}" Margin="0,3,0,0"
                         Foreground="{DynamicResource SecondaryBrush}" FontSize="11" />
              <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AmberBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OutputState}" Margin="7,0,0,0"
                               Foreground="{DynamicResource AmberBrush}" FontWeight="SemiBold" FontSize="11" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding OutputLevelText}" Margin="10,0,0,0"
                             Foreground="{DynamicResource SecondaryBrush}" />
                </Grid>
                <ProgressBar Style="{StaticResource LevelStyle}" Foreground="{DynamicResource AmberBrush}" Value="{Binding OutputLevel}" />
              </StackPanel>
              <Border Grid.Row="3" Margin="0,18,0,10" Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="13"
                      VerticalAlignment="Top">
                <Grid Margin="14,13">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource AmberBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource RemotePreferred}" Margin="8,0,0,0"
                               Foreground="{DynamicResource AmberBrush}" FontWeight="SemiBold" FontSize="11" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding OutputEndpointName}"
                             TextAlignment="Right" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding OutputEndpointName}"
                             FontWeight="SemiBold" FontSize="11" />
                </Grid>
              </Border>
              <TextBlock Grid.Row="4" Text="{DynamicResource EndpointStandby}" Foreground="{DynamicResource SecondaryBrush}" FontSize="10" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14,7">
        <ItemsControl ItemsSource="{Binding StatusRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:StatusRowViewModel}">
              <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="175" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Grid.Column="0" Width="8" Height="8" HorizontalAlignment="Left">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Warning}">
                            <Setter Property="Fill" Value="{DynamicResource AmberBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StatusTone.Error}">
                            <Setter Property="Fill" Value="{DynamicResource RedBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource SecondaryBrush}"
                             FontSize="10.5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="10.5" FontWeight="SemiBold" />
                  <Button Grid.Column="3" Content="{Binding Action}" Click="StatusAction_Click"
                          Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Style="{StaticResource PillButtonStyle}" Padding="9,3" FontSize="9.5" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </Grid>

    <!-- Mapping console -->
    <Grid Grid.Row="1" Margin="18,7,18,18"
          Visibility="{Binding IsMappingPage, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="88" />
        <RowDefinition Height="15" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="170" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="◖" Foreground="{DynamicResource GreenBrush}" FontSize="17" />
              <TextBlock Text="{DynamicResource VoiceTriggerTitle}" Margin="7,0,0,0" FontSize="16" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{DynamicResource VoiceTriggerDescription}" Margin="0,7,14,0"
                       Foreground="{DynamicResource SecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
          <ComboBox Grid.Column="1" ItemsSource="{Binding TriggerKeys}" SelectedItem="{Binding VoiceTrigger}"
                    VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource VoiceTriggerTitle}" />
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="224" />
          <ColumnDefinition Width="15" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource SupportedDevices}" Foreground="{DynamicResource SecondaryBrush}"
                       FontWeight="SemiBold" FontSize="11" />
            <ListBox Grid.Row="1" Margin="0,10,0,10" ItemsSource="{Binding Devices}"
                     SelectedItem="{Binding SelectedRemote}" Background="Transparent" BorderThickness="0">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Margin" Value="0,0,0,9" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="DeviceBorder" Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="11">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="DeviceBorder" Property="BorderBrush" Value="{DynamicResource GreenBrush}" />
                            <Setter TargetName="DeviceBorder" Property="Background" Value="{DynamicResource GreenDeepBrush}" />
                          </Trigger>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DeviceBorder" Property="Opacity" Value="0.84" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RemoteDeviceViewModel}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TertiaryBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Connected}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                      <TextBlock Text="{Binding Title}" Margin="7,0,0,0" FontSize="11.5" FontWeight="SemiBold" />
                    </StackPanel>
                    <Grid Margin="15,7,0,0">
                      <TextBlock Text="{Binding Signature}" Foreground="{DynamicResource TertiaryBrush}"
                                 FontFamily="Consolas" FontSize="10" />
                      <TextBlock Text="{Binding ConnectionText}" HorizontalAlignment="Right"
                                 Foreground="{DynamicResource TertiaryBrush}" FontSize="10" />
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
              <TextBlock Text="✓" Foreground="{DynamicResource GreenBrush}" FontWeight="Bold" />
              <TextBlock Text="{DynamicResource ModelScopedSettings}" Margin="7,0,0,0"
                         Foreground="{DynamicResource GreenBrush}" FontSize="9.5" FontWeight="SemiBold"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="145" />
              <ColumnDefinition Width="1" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="2,12,2,0">
              <Image Source="{Binding SelectedRemote.ImageUri}" Height="285" Stretch="Uniform" />
              <TextBlock Text="{Binding SelectedRemote.MappableButtonCountText}" Margin="0,8,0,0"
                         HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}"
                         FontSize="10" FontWeight="SemiBold" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource LineSoftBrush}" />

            <Grid Grid.Column="3">
              <Grid.RowDefinitions>
                <RowDefinition Height="47" />
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
                <RowDefinition Height="29" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <StackPanel>
                  <TextBlock Text="{Binding SelectedRemote.Title}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource UseMenusHint}" Margin="0,2,0,0"
                             Foreground="{DynamicResource TertiaryBrush}" FontSize="9.5" />
                </StackPanel>
                <CheckBox Content="{DynamicResource EnableMapping}" IsChecked="{Binding MappingEnabled}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
              </Grid>
              <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource LineSoftBrush}" />

              <Grid Grid.Row="1" Margin="4,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="125" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource ButtonColumn}" Margin="24,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TertiaryBrush}" FontSize="9.5" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{DynamicResource SingleColumn}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TertiaryBrush}" FontSize="9.5" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="{DynamicResource DoubleColumn}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TertiaryBrush}" FontSize="9.5" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="{DynamicResource LongColumn}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TertiaryBrush}" FontSize="9.5" FontWeight="SemiBold" />
              </Grid>

              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding SelectedRemote.Buttons}" IsEnabled="{Binding MappingEnabled}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MappingRowViewModel}">
                      <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Margin="0,0,4,5" Padding="5,2">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Symbol}" Width="23" Foreground="{DynamicResource SecondaryBrush}"
                                       FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                          </StackPanel>
                          <ComboBox Grid.Column="1" Style="{StaticResource MappingComboStyle}"
                                    Tag="Single" DropDownClosed="MappingCombo_DropDownClosed"
                                    ItemsSource="{Binding DataContext.MappingOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                    DisplayMemberPath="DisplayName" SelectedValuePath="Key"
                                    SelectedValue="{Binding SingleKey, Mode=TwoWay}" IsEnabled="{Binding Remappable}" />
                          <ComboBox Grid.Column="2" Style="{StaticResource MappingComboStyle}"
                                    Tag="Double" DropDownClosed="MappingCombo_DropDownClosed"
                                    ItemsSource="{Binding DataContext.MappingOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                    DisplayMemberPath="DisplayName" SelectedValuePath="Key"
                                    SelectedValue="{Binding DoubleKey, Mode=TwoWay}" IsEnabled="{Binding Remappable}" />
                          <ComboBox Grid.Column="3" Style="{StaticResource MappingComboStyle}"
                                    Tag="Long" DropDownClosed="MappingCombo_DropDownClosed"
                                    ItemsSource="{Binding DataContext.MappingOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                    DisplayMemberPath="DisplayName" SelectedValuePath="Key"
                                    SelectedValue="{Binding LongKey, Mode=TwoWay}" IsEnabled="{Binding Remappable}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <TextBlock Grid.Row="3" Text="{DynamicResource MappingHint}" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryBrush}" FontSize="9.5" VerticalAlignment="Center" />
              <Grid Grid.Row="4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="ⓘ" Foreground="{DynamicResource SecondaryBrush}" />
                  <TextBlock Text="{DynamicResource SystemBehaviorHint}" Margin="6,0,0,0"
                             Foreground="{DynamicResource SecondaryBrush}" FontSize="9.5" />
                </StackPanel>
                <Button Content="{DynamicResource ResetDefaults}" HorizontalAlignment="Right"
                        Click="ResetMappings_Click" Foreground="{DynamicResource GreenBrush}"
                        Background="Transparent" BorderThickness="0" FontSize="10.5" FontWeight="SemiBold" />
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
